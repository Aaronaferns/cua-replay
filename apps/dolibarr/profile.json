{
  "schema": "cua.profile/v1",
  "app": "dolibarr",
  "entry": {
    "route": "/index.php?mainmenu=home&leftmenu=home",
    "start_state": "home"
  },
  "login": {
    "state": "login",
    "username": {
      "description": "textbox \"Login\"",
      "strategies": [
        {
          "kind": "role",
          "role": "textbox",
          "name": "Login",
          "why": "label observed on the Dolibarr 23.0.4 login screen",
          "matched_at_record": "1 of 1"
        }
      ],
      "fingerprint": {
        "role": "textbox",
        "tag": "input",
        "input_type": "text"
      }
    },
    "password": {
      "description": "textbox \"Password\"",
      "strategies": [
        {
          "kind": "role",
          "role": "textbox",
          "name": "Password",
          "why": "label observed on the Dolibarr 23.0.4 login screen",
          "matched_at_record": "1 of 1"
        }
      ],
      "fingerprint": {
        "role": "textbox",
        "tag": "input",
        "input_type": "password"
      }
    },
    "submit": {
      "description": "button \"Login\"",
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": "Login",
          "why": "label observed on the Dolibarr 23.0.4 login screen",
          "matched_at_record": "1 of 1"
        }
      ],
      "fingerprint": {
        "role": "button",
        "tag": "input",
        "input_type": "submit"
      }
    }
  },
  "states": {
    "login": {
      "description": "Login form. Shown at whatever URL was requested once the session is gone, so it is recognised by its fields, never by URL.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "text",
            "equals": "Login",
            "role": "textbox"
          },
          {
            "kind": "text",
            "equals": "Password",
            "role": "textbox"
          },
          {
            "kind": "text",
            "equals": "Login",
            "role": "button"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "home": {
      "description": "Home dashboard.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/index.php*"
          },
          {
            "kind": "text",
            "equals": "Global view"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "customer_list": {
      "description": "Customers list (third parties filtered to customers).",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/societe/list.php*"
          },
          {
            "kind": "text",
            "equals": "Third-party name",
            "role": "columnheader"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "customer_card": {
      "description": "Third-party card showing the customer code row.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/societe/card.php*"
          },
          {
            "kind": "text",
            "equals": "Customer Code",
            "role": "cell"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "customer_not_found": {
      "description": "Customers list whose filter matched nothing: the table body says 'No record found'.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/societe/list.php*"
          },
          {
            "kind": "text",
            "equals": "Third-party name",
            "role": "columnheader"
          },
          {
            "kind": "text",
            "equals": "No record found",
            "role": "cell"
          }
        ]
      },
      "specializes": "customer_list",
      "origin": "observed",
      "edited": false
    },
    "customer_tab": {
      "description": "Third-party 'Customer' tab: customer code plus the outstanding-bill summary.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/comm/card.php*"
          },
          {
            "kind": "text",
            "equals": "Customer Code",
            "role": "cell"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "invoice_card": {
      "description": "Customer invoice card (any status).",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/compta/facture/card.php*"
          },
          {
            "kind": "text",
            "equals": "Customer invoice",
            "role": "link"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "payment_form": {
      "description": "Payment entry form for a customer invoice.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/compta/paiement.php*"
          },
          {
            "kind": "text",
            "equals": "Enter payment received from customer",
            "role": "cell"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "access_denied": {
      "description": "Dolibarr's 'Access denied' page, shown at the URL that was refused.",
      "layer": "page",
      "signature": {
        "kind": "text",
        "pattern": "Access denied\\..*"
      },
      "origin": "observed",
      "edited": false
    },
    "invoice_validate_confirm": {
      "description": "Confirmation dialog asking whether to validate a draft invoice.",
      "layer": "dialog",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "text",
            "equals": "Validate invoice",
            "role": "dialog"
          },
          {
            "kind": "text",
            "equals": "Yes",
            "role": "button"
          }
        ]
      },
      "origin": "observed",
      "edited": false
    },
    "payment_confirm": {
      "description": "Payment form after Pay: Dolibarr asks 'Do you confirm this payment input' (an inline Yes/No select and a Validate button, not a dialog). Submitting it posts the payment.",
      "layer": "page",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "url_matches",
            "pattern": "/compta/paiement.php*"
          },
          {
            "kind": "text",
            "equals": "Enter payment received from customer",
            "role": "cell"
          },
          {
            "kind": "text",
            "pattern": "Do you confirm this payment input for .*",
            "role": "cell"
          }
        ]
      },
      "specializes": "payment_form",
      "origin": "observed",
      "edited": false
    },
    "login_captcha": {
      "description": "Login form with a CAPTCHA: a 'Security code' textbox only a person can fill.",
      "layer": "page",
      "signature": {
        "kind": "text",
        "equals": "Security code",
        "role": "textbox"
      },
      "specializes": "login",
      "origin": "declared",
      "edited": false
    },
    "app_error": {
      "description": "The application answered with a server error page.",
      "layer": "page",
      "signature": {
        "kind": "text",
        "equals": "Internal Server Error",
        "role": "heading"
      },
      "origin": "declared",
      "edited": false
    },
    "service_notice": {
      "description": "A service-notice modal (maintenance or announcement) with one Dismiss button.",
      "layer": "dialog",
      "signature": {
        "kind": "all",
        "of": [
          {
            "kind": "text",
            "equals": "Service notice",
            "role": "heading"
          },
          {
            "kind": "text",
            "equals": "Dismiss",
            "role": "button"
          }
        ]
      },
      "origin": "declared",
      "edited": false
    }
  },
  "default_meaning": {
    "login": {
      "failure": "SESSION_EXPIRED"
    },
    "customer_not_found": {
      "outcome": "customer_not_found"
    },
    "access_denied": {
      "outcome": "access_denied"
    },
    "login_captcha": {
      "failure": "HUMAN_ONLY_LOGIN"
    },
    "app_error": {
      "failure": "APP_ERROR"
    }
  },
  "handlers": {
    "login": {
      "state": "login",
      "flow": "login",
      "then": "restart_if_retry_safe",
      "max_per_run": 1
    },
    "dismiss_notice": {
      "state": "service_notice",
      "dismiss": {
        "description": "button \"Dismiss\"",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Dismiss",
            "why": "the notice's only control",
            "matched_at_record": "1 of 1"
          }
        ],
        "fingerprint": {
          "role": "button",
          "tag": "button"
        }
      },
      "then": "reclassify",
      "max_per_run": 2
    }
  },
  "commit_routes": [
    {
      "method": "GET",
      "path": "*",
      "query": {
        "action": "confirm_valid",
        "confirm": "yes"
      },
      "body": {}
    },
    {
      "method": "GET",
      "path": "*",
      "query": {
        "action": "confirm_*"
      },
      "body": {}
    },
    {
      "method": "POST",
      "path": "/compta/paiement.php",
      "query": {},
      "body": {
        "action": "confirm_paiement",
        "confirm": "yes"
      }
    }
  ],
  "number_format": {
    "decimal": ".",
    "group": ","
  }
}
