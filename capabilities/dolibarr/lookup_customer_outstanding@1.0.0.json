{
  "schema": "cua.capability/v1",
  "id": "dolibarr.lookup_customer_outstanding",
  "version": "1.0.0",
  "title": "Lookup customer outstanding",
  "description": "Find the current outstanding bill amount of the customer with customer code <customer_code>.",
  "app": "dolibarr",
  "contract": {
    "inputs": {
      "customer_code": {
        "type": "string",
        "description": "the customer code",
        "pattern": "CU\\d{4}-\\d{4,5}",
        "sensitivity": "pii"
      }
    },
    "outputs": {
      "outstanding_amount": {
        "type": "decimal",
        "description": "the current outstanding bill amount",
        "sensitivity": "internal"
      }
    },
    "outcomes": {
      "customer_not_found": {
        "description": "Customers list whose filter matched nothing: the table body says 'No record found'.",
        "returns": []
      },
      "access_denied": {
        "description": "Dolibarr's 'Access denied' page, shown at the URL that was refused.",
        "returns": []
      }
    }
  },
  "effect": "read",
  "steps": [
    {
      "id": "s01_navigate",
      "intent": "Open the third-party list filtered by the customer code.",
      "expect": "home",
      "do": {
        "kind": "navigate",
        "route": "/societe/list.php?search_customer_code=${customer_code}"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s02_click",
      "intent": "Open the customer card for the matching third party, which shows the current outstanding bill.",
      "expect": "customer_list",
      "do": {
        "kind": "click",
        "target": "link_c"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s03_assert",
      "intent": "The screen shows the requested <customer_code>",
      "expect": "customer_tab",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "cell_customer_code",
          "input": "customer_code",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s04_extract",
      "intent": "Use the element with the stable \"Current outstanding bill\" label, whose text includes the amount.",
      "expect": "customer_tab",
      "do": {
        "kind": "extract",
        "target": "generic_current_outstanding_bill",
        "output": "outstanding_amount"
      },
      "effect": "read",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    }
  ],
  "success": {
    "state": "customer_tab",
    "outputs": [
      "outstanding_amount"
    ],
    "checks": [
      {
        "kind": "target_visible",
        "target": "cell_customer_code"
      },
      {
        "kind": "target_visible",
        "target": "generic_current_outstanding_bill"
      }
    ]
  },
  "targets": {
    "link_c": {
      "description": "role link \"C\"",
      "strategies": [
        {
          "kind": "role",
          "role": "link",
          "name": "C",
          "why": "role and exact name",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "table_cell",
          "role": "link",
          "row_key": "${customer_code}",
          "column": "Nature of Third party",
          "why": "its column header, in the row keyed by the input",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "table_cell",
          "role": "link",
          "column": "Nature of Third party",
          "why": "its column header, in the row keyed by the input",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "scoped",
          "role": "link",
          "name": "C",
          "within_role": "columnheader",
          "within_name": "Nature of Third party",
          "why": "scoped by the container it sits in",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "scoped",
          "role": "link",
          "within_role": "columnheader",
          "within_name": "Nature of Third party",
          "why": "scoped by the container it sits in",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "role",
          "role": "link",
          "name": "c",
          "why": "normalized name (low rank)",
          "matched_at_record": "1 of 1, same element as ref"
        },
        {
          "kind": "css",
          "css": "a.customer-back",
          "why": "stable attributes (structural fallback)",
          "matched_at_record": "1 of 1, same element as ref"
        }
      ],
      "fingerprint": {
        "role": "link",
        "tag": "a",
        "column_header": "Nature of Third party"
      }
    },
    "cell_customer_code": {
      "description": "value in the row labelled \"Customer Code\"",
      "strategies": [
        {
          "kind": "same_row",
          "label": "Customer Code",
          "take": "value",
          "why": "the row's label cell leads to it",
          "matched_at_record": "1 of 1, same element as ref"
        }
      ],
      "fingerprint": {
        "role": "cell",
        "tag": "td",
        "row_label": "Customer Code"
      }
    },
    "generic_current_outstanding_bill": {
      "description": "role generic \"Current outstanding bill\"",
      "strategies": [
        {
          "kind": "role",
          "role": "generic",
          "name": "Current outstanding bill",
          "why": "role and exact name",
          "matched_at_record": "1 of 1, same element as ref"
        }
      ],
      "fingerprint": {
        "role": "generic",
        "tag": "div"
      }
    }
  },
  "provenance": {
    "trace_run_id": "discovery_lookup_customer_outstanding",
    "trace_sha256": "1d65bc52793d5c494b4f68e74be666020764a8474cbbd331f617287393e84dcc",
    "discovered_by": "claude-opus-5-5",
    "compiler": "cua.compiler/v0"
  }
}
