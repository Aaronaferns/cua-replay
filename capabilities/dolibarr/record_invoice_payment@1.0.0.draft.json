{
  "schema": "cua.capability/v1",
  "id": "dolibarr.record_invoice_payment",
  "version": "1.0.0",
  "title": "Record invoice payment",
  "description": "Record a payment of <amount> on customer invoice <invoice_ref> using payment method <method> into bank account <bank_account>, confirm it, and read the reference of the payment that was created.",
  "app": "dolibarr",
  "contract": {
    "inputs": {
      "invoice_ref": {
        "type": "string",
        "description": "",
        "sensitivity": "internal"
      },
      "amount": {
        "type": "string",
        "description": "",
        "sensitivity": "internal"
      },
      "method": {
        "type": "string",
        "description": "",
        "sensitivity": "internal"
      },
      "bank_account": {
        "type": "string",
        "description": "",
        "sensitivity": "internal"
      },
      "request_id": {
        "type": "string",
        "description": "idempotency key of this commit",
        "sensitivity": "internal"
      }
    },
    "outputs": {
      "payment_ref": {
        "type": "string",
        "description": "",
        "sensitivity": "internal"
      }
    },
    "outcomes": {
      "access_denied": {
        "description": "Dolibarr's 'Access denied' page, shown at the URL that was refused.",
        "returns": []
      },
      "invoice_not_found": {
        "description": "Invoice list whose filter matched nothing: the table body says 'No record found'.",
        "returns": []
      },
      "validation_rejected": {
        "description": "Payment confirmation carrying Dolibarr's warning that the amount is higher than the outstanding amount (the confirmation defaults to No).",
        "returns": []
      }
    }
  },
  "effect": "commit",
  "steps": [
    {
      "id": "s01_navigate",
      "intent": "Open the customer invoice list filtered by the invoice reference placeholder.",
      "expect": "home",
      "do": {
        "kind": "navigate",
        "route": "/compta/facture/list.php?mainmenu=billing&leftmenu=customers_bills&search_ref=${invoice_ref}"
      },
      "effect": "read",
      "navigates": true,
      "on": [
        {
          "state": "invoice_not_found",
          "outcome": "invoice_not_found"
        }
      ],
      "timeout_ms": 10000
    },
    {
      "id": "s02_click",
      "intent": "Open the matching invoice card.",
      "expect": "invoice_list",
      "do": {
        "kind": "click",
        "target": "link_invoice_ref"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s03_click",
      "intent": "Open the payment entry form for this invoice.",
      "expect": "invoice_card",
      "do": {
        "kind": "click",
        "target": "link_enter_payment"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s04_select",
      "intent": "Choose the requested payment method.",
      "expect": "payment_form",
      "do": {
        "kind": "select",
        "target": "combobox_select_selectpaiementcode",
        "option": "${method}"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s05_select",
      "intent": "Choose the requested bank account to credit.",
      "expect": "payment_form",
      "do": {
        "kind": "select",
        "target": "combobox_select_selectaccountid",
        "option": "${bank_account}"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s06_assert",
      "intent": "The screen shows the requested <bank_account>",
      "expect": "payment_form",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "combobox_select_selectaccountid",
          "input": "bank_account",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s07_click",
      "intent": "Set the payment date to today since the date field is empty.",
      "expect": "payment_form",
      "do": {
        "kind": "click",
        "target": "button_now"
      },
      "effect": "read",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s08_type",
      "intent": "Enter the payment amount on the target invoice's row only.",
      "expect": "payment_form",
      "do": {
        "kind": "type",
        "target": "textbox_payment_amount",
        "text": "${amount}"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "verify": {
        "kind": "target_equals_input",
        "target": "textbox_payment_amount",
        "input": "amount",
        "normalizer": "exact"
      },
      "timeout_ms": 10000
    },
    {
      "id": "s09_click",
      "intent": "Submit the payment form, which leads to Dolibarr's confirmation step.",
      "expect": "payment_form",
      "do": {
        "kind": "click",
        "target": "button_pay"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s10_assert",
      "intent": "The review screen shows the requested <invoice_ref>",
      "expect": "payment_confirm",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "link_invoice_ref",
          "input": "invoice_ref",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s11_assert",
      "intent": "The review screen shows the requested <amount>",
      "expect": "payment_confirm",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "textbox_payment_amount",
          "input": "amount",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s12_assert",
      "intent": "The review screen shows the requested <bank_account>",
      "expect": "payment_confirm",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "combobox_select_selectaccountid",
          "input": "bank_account",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s13_click",
      "intent": "Confirm the requested payment (Yes is selected); this commits the payment.",
      "expect": "payment_confirm",
      "do": {
        "kind": "click",
        "target": "button_validate"
      },
      "effect": "commit",
      "navigates": true,
      "on": [],
      "verify": {
        "kind": "all",
        "of": [
          {
            "kind": "target_equals_input",
            "target": "cell_amount",
            "input": "amount",
            "normalizer": "text"
          },
          {
            "kind": "target_visible",
            "target": "cell_payments"
          }
        ]
      },
      "timeout_ms": 10000
    },
    {
      "id": "s14_assert",
      "intent": "The screen shows the requested <amount>",
      "expect": "invoice_card",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "cell_amount",
          "input": "amount",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s15_extract",
      "intent": "Record the reference of the newly created payment on this invoice.",
      "expect": "invoice_card",
      "do": {
        "kind": "extract",
        "target": "cell_payments",
        "output": "payment_ref"
      },
      "effect": "read",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s16_click",
      "intent": "Open the created payment's card, where the ref sits in a field with a stable label.",
      "expect": "invoice_card",
      "do": {
        "kind": "click",
        "target": "link_payments"
      },
      "effect": "read",
      "navigates": true,
      "on": [],
      "timeout_ms": 10000
    },
    {
      "id": "s17_assert",
      "intent": "The screen shows the requested <method>",
      "expect": "payment_card",
      "do": {
        "kind": "assert",
        "that": {
          "kind": "target_equals_input",
          "target": "cell_method",
          "input": "method",
          "normalizer": "text"
        },
        "on_fail": "IDENTITY_MISMATCH"
      },
      "effect": "none",
      "navigates": false,
      "on": [],
      "timeout_ms": 10000
    }
  ],
  "success": {
    "state": "payment_card",
    "outputs": [
      "payment_ref"
    ],
    "checks": [
      {
        "kind": "target_visible",
        "target": "generic_div_marginbottomonly"
      },
      {
        "kind": "target_visible",
        "target": "cell_invoice"
