# Copy to .env (git-ignored) and fill in. Nothing in this file is a real secret.

# Discovery only. Replay never calls a model and needs no key.
ANTHROPIC_API_KEY=

# Target: local Dolibarr 23.0.4 in Docker (target/dolibarr/docker-compose.yml).
# Browsers use localhost; Python clients use 127.0.0.1 (Windows resolves localhost to IPv6 first).
DOLIBARR_PORT=8085
DOLIBARR_DB_ROOT_PASSWORD=change-me-root
DOLIBARR_DB_PASSWORD=change-me-db
DOLIBARR_ADMIN_PASSWORD=change-me-admin
# Admin REST key used only by fixtures, tests and evidence ground truth (never by discovery or replay).
DOLIBARR_API_KEY=change-me-apikey

# The account automation logs in as (scripted login flow; the model never sees it).
CUA_RUN_LOGIN=cua_operator
CUA_RUN_PASSWORD=change-me-run
# A user without invoice/customer rights, for the access-denied case.
CUA_NOPERM_PASSWORD=change-me-noperm
